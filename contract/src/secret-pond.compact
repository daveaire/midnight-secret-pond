pragma language_version 0.26;

import CompactStandardLibrary;

export ledger acceptedProofs: Counter;
export ledger lastCommitment: Bytes<32>;
export ledger minNetBps: Uint<64>;
export ledger maxBridgeSeconds: Uint<64>;
export ledger minLiquidityUsd: Uint<64>;

constructor() {
  minNetBps = 25;
  maxBridgeSeconds = 1200;
  minLiquidityUsd = 10000;
}

witness privateRouteHash(): Bytes<32>;
witness privateNetBps(): Uint<64>;
witness privateBridgeSeconds(): Uint<64>;
witness privateLiquidityUsd(): Uint<64>;

export circuit proveOpportunity(): Bytes<32> {
  const routeHash = privateRouteHash();
  const netBps = privateNetBps();
  const bridgeSeconds = privateBridgeSeconds();
  const liquidityUsd = privateLiquidityUsd();

  assert(netBps >= minNetBps, "Net return is below policy");
  assert(bridgeSeconds <= maxBridgeSeconds, "Bridge is too slow");
  assert(liquidityUsd >= minLiquidityUsd, "Liquidity is below policy");

  const commitment = opportunityCommitment(routeHash, netBps, bridgeSeconds, liquidityUsd);
  assert(commitment != lastCommitment, "Opportunity proof was already published");
  lastCommitment = disclose(commitment);
  acceptedProofs.increment(1);
  return disclose(commitment);
}

export circuit opportunityCommitment(
  routeHash: Bytes<32>,
  netBps: Uint<64>,
  bridgeSeconds: Uint<64>,
  liquidityUsd: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "secret-pond:v1:"),
    routeHash,
    netBps as Field as Bytes<32>,
    bridgeSeconds as Field as Bytes<32>,
    liquidityUsd as Field as Bytes<32>
  ]);
}
